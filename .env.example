# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL=https://akshfinserv.com

# Resend (transactional email for /api/lead and /api/newsletter)
RESEND_API_KEY=
LEAD_TO_EMAIL=plabita@akshfinserv.com
LEAD_FROM_EMAIL=website@akshfinserv.com
# Optional: Resend segment that newsletter signups join. Without it, signups are emailed to LEAD_TO_EMAIL.
RESEND_SEGMENT_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Cal.com booking link for the lead block
NEXT_PUBLIC_CALCOM_URL=

# NJ client logins (kept from the old site)
NEXT_PUBLIC_NJ_EWA_LOGIN=https://ewa.njindiaonline.com/ewa/login
NEXT_PUBLIC_NJ_CDESK_LOGIN=https://cdesk.njwealth.in/cdesk/login
